{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "target": "es2022",           // Node 20 supports es2022 features natively
    "esModuleInterop": true,      // Essential for importing CJS/ESM mixed libraries
    "skipLibCheck": true          // Recommended to avoid errors from node_modules types
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}