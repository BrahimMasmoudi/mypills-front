{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "linter": "yarn lint --fix",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate": "GCLOUD_PROJECT=my-pills-staging-460b5 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 FIRESTORE_EMULATOR_HOST=localhost:8080 yarn fireway migrate --require=ts-node/register --debug --path ./migrations",
    "migrate:prod": "yarn fireway migrate --require=ts-node/register --path ./migrations"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@qualdesk/firestore-big-batch": "^0.0.2",
    "cors": "^2.8.5",
    "date-fns-tz": "^3.2.0",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^7.0.5",
    "fireway": "^1.1.0",
    "undici": "^7.18.2"
  },
  "devDependencies": {
    "@google-cloud/tasks": "^6.2.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "date-fns": "4.1.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "private": true
}
